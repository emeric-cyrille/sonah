# SONAH — production (fichier ~/sonah/.env.production sur le VPS, chmod 600).
# Seules les variables lues par le code ou par docker-compose.prod.yml figurent ici.
# NODE_ENV, API_PORT, APP_VERSION et DATABASE_URL sont fixés par docker-compose.prod.yml.

# Application
FRONTEND_URL=https://sonah.fokamemeric.com
CORS_ORIGIN="https://sonah.fokamemeric.com"

# PostgreSQL — généré automatiquement par scripts/deploy.sh s'il manque.
# DATABASE_URL est construite par docker-compose.prod.yml à partir de ce mot de passe.
# Laisser la ligne commentée pour que le script la génère.
# POSTGRES_PASSWORD=

# Neo4j — optionnel : renseigner NEO4J_URI active le profil « graph » au déploiement
# (NEO4J_PASSWORD est alors généré s'il manque).
NEO4J_URI="bolt://neo4j:7687"
NEO4J_USER="neo4j"
# NEO4J_PASSWORD=

# Groq (palier gratuit, prioritaire) — https://console.groq.com/keys
# Fournisseur du modèle de rédaction imposé : groq | gemini | openai (vide : selon les clés présentes)
# Synchronisé par la CI depuis la variable du dépôt LLM_PROVIDER (gemini : Gemini relayé par Groq)
LLM_PROVIDER=
# GROQ_API_KEY est synchronisée par la CI (secret GROQ_API_KEY + variable ENABLE_GROQ=true).
# Palier gratuit, par modèle : 30 requêtes/min, 1 000 requêtes/jour, 8 000 jetons/min ;
# le modèle de secours prend le relais quand le modèle principal est saturé.
GROQ_API_KEY=""
GROQ_CHAT_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL="qwen/qwen3.8-27b"

# Embeddings : EMBEDDING_PROVIDER=local et EMBEDDINGS_CACHE_DIR=/app/models sont fixés par
# docker-compose.prod.yml (modèle intégré à l'image, jamais téléchargé en production).
# Changer de modèle impose de reconstruire l'image (argument LOCAL_EMBEDDING_MODEL) : le seed réindexe alors.
# LOCAL_EMBEDDING_MODEL="Xenova/multilingual-e5-small"
EMBEDDING_RELEVANCE_THRESHOLD=""

# Gemini — désactivé (clé refusée, HTTP 403). Les embeddings restent locaux même si la clé est présente.
# GEMINI_API_KEY peut être synchronisée par la CI (secret GEMINI_API_KEY + variable ENABLE_GEMINI=true).
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL=""
GEMINI_EMBEDDING_MODEL=""

# OpenAI (alternative payante) — sans aucune clé, Sonah cite les articles sans rédiger de réponse.
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Jeton d'administration pour POST /api/v1/documents (openssl rand -hex 24)
ADMIN_TOKEN=""
