# Production Environment Variables
# Copy to .env.production and fill with actual values

# Application
NODE_ENV=production
API_PORT=4000
FRONTEND_URL=https://sonah.fokamemeric.com
API_URL=https://api.sonah.fokamemeric.com

# Database (Production PostgreSQL)
DATABASE_URL="postgresql://sonah_user:STRONG_PASSWORD@localhost:5432/sonah_prod"

# Neo4j (Production)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="STRONG_NEO4J_PASSWORD"

# Redis (Production)
REDIS_URL="redis://:STRONG_REDIS_PASSWORD@localhost:6379"

# RabbitMQ (Production)
RABBITMQ_URL="amqp://sonah_admin:STRONG_RABBITMQ_PASSWORD@localhost:5672"

# OpenAI
OPENAI_API_KEY="sk-proj-VOTRE_CLE_PRODUCTION"

# Mistral (optional fallback)
MISTRAL_API_KEY=""

# JWT
JWT_SECRET="STRONG_RANDOM_JWT_SECRET_MINIMUM_32_CHARACTERS"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="https://sonah.fokamemeric.com"

# WhatsApp Business API (Phase 2)
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# Africa's Talking USSD (Phase 2)
AFRICAS_TALKING_API_KEY=""
AFRICAS_TALKING_USERNAME=""

# Monitoring & Logging
LOG_LEVEL="info"
SENTRY_DSN=""

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
