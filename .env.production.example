# Production Environment Variables - VPS Seazone
# Copy to .env.production and fill with actual values

# Application
NODE_ENV=production
API_PORT=4000
FRONTEND_URL=https://sonah.fokamemeric.com
API_URL=https://sonah.fokamemeric.com/api/v1

# Database — POSTGRES_PASSWORD est généré automatiquement par scripts/deploy.sh s'il manque.
# DATABASE_URL est construite par docker-compose.prod.yml à partir de ce mot de passe.
POSTGRES_PASSWORD="STRONG_PASSWORD"

# Neo4j — optionnel : renseigner NEO4J_URI active le profil « graph » au déploiement
# (NEO4J_PASSWORD est alors généré s'il manque).
NEO4J_URI="bolt://neo4j:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="STRONG_NEO4J_PASSWORD"

# Redis
REDIS_URL="redis://:STRONG_REDIS_PASSWORD@redis:6379"
REDIS_PASSWORD="STRONG_REDIS_PASSWORD"

# RabbitMQ
RABBITMQ_URL="amqp://sonah_admin:STRONG_RABBITMQ_PASSWORD@rabbitmq:5672"
RABBITMQ_USER="sonah_admin"
RABBITMQ_PASSWORD="STRONG_RABBITMQ_PASSWORD"

# Gemini (palier gratuit, prioritaire sur OpenAI) — https://aistudio.google.com/apikey
# Attention : sur le palier gratuit, Google peut utiliser les requêtes pour améliorer ses produits.
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
EMBEDDING_RELEVANCE_THRESHOLD=""

# OpenAI (alternative payante) — sans aucune clé, Sonah cite les articles sans rédiger de réponse.
OPENAI_API_KEY="sk-proj-VOTRE_CLE_PRODUCTION"
OPENAI_CHAT_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Jeton d'administration pour POST /api/v1/documents (openssl rand -hex 24)
ADMIN_TOKEN=""

# Mistral (optional fallback)
MISTRAL_API_KEY=""

# JWT (Generate with: openssl rand -base64 32)
JWT_SECRET="STRONG_RANDOM_JWT_SECRET_MINIMUM_32_CHARACTERS"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="https://sonah.fokamemeric.com"

# WhatsApp Business API (Phase 2)
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# Africa's Talking USSD (Phase 2)
AFRICAS_TALKING_API_KEY=""
AFRICAS_TALKING_USERNAME=""

# Monitoring & Logging
LOG_LEVEL="info"
SENTRY_DSN=""

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
