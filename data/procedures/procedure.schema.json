{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonah.cm/schemas/procedure.schema.json",
  "title": "SONAH procedure sheet (fiche démarche)",
  "description": "A structured, sourced description of one Cameroonian administrative procedure. Every factual field must be traceable to an entry of `sources`; fields that could not be verified are null (or omitted from lists) and listed in `unverified`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title_fr",
    "title_en",
    "category",
    "keywords_fr",
    "keywords_en",
    "authority",
    "where",
    "who_can_apply",
    "documents",
    "steps",
    "cost",
    "delay",
    "validity",
    "legal_basis",
    "tips",
    "sources",
    "verified_at",
    "unverified",
    "language_versions"
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sourceRefs": {
      "description": "Indexes (0-based) into the sheet's `sources` array supporting this item.",
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "uniqueItems": true
    },
    "sourcedText": {
      "description": "A text item with the indexes of the sources that support it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source_refs"],
      "properties": {
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "source_refs": { "$ref": "#/$defs/sourceRefs" }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "description": "Slug, identical to the file name without .json.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title_fr": { "$ref": "#/$defs/nonEmptyString" },
    "title_en": { "$ref": "#/$defs/nonEmptyString" },
    "category": {
      "enum": [
        "identite",
        "etat-civil",
        "justice",
        "sante",
        "transport",
        "entreprise",
        "fiscalite",
        "social",
        "elections",
        "education",
        "autre"
      ]
    },
    "keywords_fr": {
      "description": "Words and phrases citizens actually type, including colloquial forms and acronyms.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "keywords_en": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "level"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "level": { "enum": ["national", "regional", "communal", "private"] },
        "source_refs": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "where": {
      "description": "Offices, counters or online portals where the procedure is carried out.",
      "type": "array",
      "items": { "$ref": "#/$defs/sourcedText" }
    },
    "who_can_apply": {
      "oneOf": [{ "$ref": "#/$defs/sourcedText" }, { "type": "null" }]
    },
    "documents": {
      "description": "Supporting documents to provide. Empty only if none could be verified (then listed in `unverified`).",
      "type": "array",
      "items": { "$ref": "#/$defs/sourcedText" }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "description", "source_refs"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "description": { "$ref": "#/$defs/nonEmptyString" },
          "source_refs": { "$ref": "#/$defs/sourceRefs" }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount_fcfa", "description"],
      "properties": {
        "amount_fcfa": {
          "description": "Official fixed amount in FCFA, or null when variable / not verified.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "description": {
          "description": "Breakdown or explanation (e.g. fee set by the facility). Null when nothing could be verified.",
          "type": ["string", "null"]
        },
        "source_refs": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "delay": {
      "oneOf": [{ "$ref": "#/$defs/sourcedText" }, { "type": "null" }]
    },
    "validity": {
      "oneOf": [{ "$ref": "#/$defs/sourcedText" }, { "type": "null" }]
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "reference", "title"],
        "properties": {
          "sourceId": {
            "description": "Id of the text in data/sources/manifest.json, or null when the text is not in the corpus.",
            "type": ["string", "null"]
          },
          "reference": { "$ref": "#/$defs/nonEmptyString" },
          "title": { "$ref": "#/$defs/nonEmptyString" },
          "source_refs": { "$ref": "#/$defs/sourceRefs" }
        }
      }
    },
    "tips": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourcedText" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "publisher"],
        "properties": {
          "title": { "$ref": "#/$defs/nonEmptyString" },
          "url": { "type": "string", "pattern": "^https?://" },
          "publisher": { "$ref": "#/$defs/nonEmptyString" },
          "official": {
            "description": "True when published by a Cameroonian public authority (or the corpus law text).",
            "type": "boolean"
          },
          "accessed_at": { "type": "string", "format": "date" }
        }
      }
    },
    "verified_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "unverified": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "note"],
        "properties": {
          "field": { "$ref": "#/$defs/nonEmptyString" },
          "note": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "language_versions": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["fr", "en"] },
      "uniqueItems": true
    }
  }
}
