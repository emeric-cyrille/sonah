{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonah.cm/schemas/sources-manifest.json",
  "title": "Sonah knowledge base — source manifest",
  "description": "Official and reference texts indexed by Sonah. Kept in sync with the zod schema in packages/rag/src/ingestion/sources.ts (checked by manifest.spec.ts).",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "$schema": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sourceId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "docId",
        "issuingBody",
        "title",
        "titleFr",
        "titleEn",
        "shortTitle",
        "type",
        "category",
        "jurisdiction",
        "binding",
        "language",
        "version",
        "date",
        "url",
        "accessedAt",
        "license",
        "redistribution",
        "domains",
        "ituDimensions",
        "ituFolder",
        "chunking"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/sourceId",
          "description": "Technical id, prefix of every chunk key"
        },
        "docId": {
          "type": "string",
          "pattern": "^[A-Z0-9.-]+$",
          "description": "Stable document id"
        },
        "issuingBody": { "type": "string", "minLength": 1 },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Title in the document language"
        },
        "titleFr": { "type": "string", "minLength": 1 },
        "titleEn": { "type": "string", "minLength": 1 },
        "shortTitle": { "type": "string", "minLength": 1, "maxLength": 60 },
        "type": {
          "enum": [
            "CONSTITUTION",
            "LAW",
            "DECREE",
            "PROCEDURE",
            "FORM",
            "STRATEGY",
            "INTERNATIONAL",
            "OTHER"
          ]
        },
        "category": { "type": "string", "minLength": 1, "maxLength": 100 },
        "jurisdiction": { "type": "string", "pattern": "^[A-Z]{2,3}$|^INT$" },
        "binding": { "enum": ["binding", "advisory"] },
        "language": { "enum": ["fr", "en"] },
        "version": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/isoDate" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "accessedAt": { "$ref": "#/$defs/isoDate" },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the original artefact downloaded from fetch.url (required unless metadata-only)"
        },
        "license": { "type": "string", "minLength": 1 },
        "redistribution": { "enum": ["redistributable", "fetch-only", "metadata-only"] },
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "ituDimensions": {
          "type": "array",
          "items": {
            "enum": [
              "data_marketplace",
              "generated_content",
              "cross_domain",
              "contextualization",
              "ai_integration",
              "human_interface",
              "strategy_alignment",
              "collaboration",
              "human_impact",
              "ai_policies",
              "ai_inclusion",
              "granular_priorities",
              "digital_infrastructure"
            ]
          }
        },
        "ituFolder": { "enum": ["AI_Strategies", "AI_Use_Cases"] },
        "file": { "type": "string", "pattern": "^[\\w.-]+\\.(pdf|txt)$" },
        "fetch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "format"],
          "properties": {
            "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
            "format": { "enum": ["pdf", "html"] },
            "resolver": { "enum": ["prc-cm"] },
            "headers": { "type": "object", "additionalProperties": { "type": "string" } },
            "encoding": { "type": "string" }
          }
        },
        "derivation": { "type": "string" },
        "segment": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "start": { "type": "string" }, "end": { "type": "string" } }
        },
        "replacements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pattern", "replacement"],
            "properties": {
              "pattern": { "type": "string" },
              "replacement": { "type": "string" },
              "flags": { "type": "string", "pattern": "^[gimsu]*$" }
            }
          }
        },
        "noisePatterns": { "type": "array", "items": { "type": "string" } },
        "chunking": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["articles", "numbered-paragraphs", "sections"] },
            "articleStyle": { "enum": ["fr", "en-section", "line"] },
            "preambleLabel": { "type": ["string", "null"] },
            "unitPatterns": { "type": "array", "items": { "type": "string" } },
            "headingPatterns": { "type": "array", "items": { "type": "string" } },
            "stopPattern": { "type": "string" },
            "maxChars": { "type": "integer", "minimum": 300, "maximum": 8000 }
          }
        },
        "amends": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceId", "articles"],
          "properties": {
            "sourceId": { "$ref": "#/$defs/sourceId" },
            "articles": {
              "type": "object",
              "additionalProperties": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "repeals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceId"],
          "properties": {
            "sourceId": { "$ref": "#/$defs/sourceId" },
            "articles": { "type": "array", "items": { "type": "string" } }
          }
        },
        "note": { "type": "string" }
      }
    }
  }
}
