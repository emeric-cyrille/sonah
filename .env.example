# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/sonah"

# Neo4j
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"

# Redis
REDIS_URL="redis://localhost:6379"

# RabbitMQ
RABBITMQ_URL="amqp://localhost:5672"

# OpenAI (optionnel en développement)
# Sans clé : embeddings lexicaux hors ligne et réponses qui citent les articles sans rédaction.
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Jeton requis pour POST /api/v1/documents (au moins 24 caractères). Vide : ajout désactivé.
ADMIN_TOKEN=""

# Mistral (optional fallback)
MISTRAL_API_KEY=""

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# App URLs
NEXT_PUBLIC_API_URL="http://localhost:4000"
API_PORT=4000

# WhatsApp Business API (Phase 2)
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# Africa's Talking USSD (Phase 2)
AFRICAS_TALKING_API_KEY=""
AFRICAS_TALKING_USERNAME=""

# Node Environment
NODE_ENV="development"
