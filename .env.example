# SONAH — développement local. Copier vers .env et compléter si besoin.
# Seules les variables lues par le code figurent ici.

# Application
NODE_ENV="development"
API_PORT=4000
# Origine autorisée par l'API (à défaut : FRONTEND_URL, puis http://localhost:3000)
CORS_ORIGIN="http://localhost:3000"
# Cible du proxy /api/v1 du serveur Next.js (apps/web/next.config.mjs)
API_PROXY_URL="http://localhost:4000"

# PostgreSQL + pgvector (docker compose up -d postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/sonah"

# Neo4j — optionnel : NEO4J_URI vide = Sonah fonctionne sans le graphe
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"

# Modèle de langage — Groq (palier gratuit, prioritaire), puis Gemini, puis OpenAI.
# Sans aucune clé : réponses qui citent les articles sans rédaction.
# Clé Groq : https://console.groq.com/keys — palier gratuit, par modèle : 30 requêtes/min,
# 1 000 requêtes/jour, 8 000 jetons/min. Le modèle de secours prend le relais en cas de quota atteint.
# Fournisseur du modèle de rédaction imposé : groq | gemini | openai (vide : selon les clés présentes)
LLM_PROVIDER=
GROQ_API_KEY=""
GROQ_CHAT_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL="qwen/qwen3.8-27b"

# Embeddings — « local » : modèle multilingue exécuté sur la machine (gratuit, aucune donnée envoyée),
# téléchargé une fois depuis Hugging Face dans EMBEDDINGS_CACHE_DIR (vide : cache de transformers.js).
# Vide : Gemini ou OpenAI si leur clé est présente, sinon local. « hashing » : tests hors ligne.
EMBEDDING_PROVIDER="local"
LOCAL_EMBEDDING_MODEL="Xenova/multilingual-e5-small"
EMBEDDINGS_CACHE_DIR=""

# Gemini (clé : https://aistudio.google.com/apikey) — palier gratuit : Google peut utiliser les requêtes
# pour améliorer ses produits (aucune donnée personnelle). Modèles vides = valeurs par défaut de l'API.
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL=""
GEMINI_EMBEDDING_MODEL=""

OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Seuil de pertinence calibré pour le modèle d'embedding (vide : valeur par défaut du modèle)
EMBEDDING_RELEVANCE_THRESHOLD=""

# Jeton requis pour POST /api/v1/documents (au moins 24 caractères). Vide : ajout désactivé.
ADMIN_TOKEN=""
