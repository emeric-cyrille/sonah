{
  "name": "@sonah/rag",
  "version": "0.1.0",
  "private": true,
  "description": "Triple RAG de Sonah : recherche vectorielle (pgvector), graphe (Neo4j), découpage des textes juridiques",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" --max-warnings 0",
    "test": "jest",
    "seed": "ts-node --transpile-only scripts/seed-legal.ts",
    "kb:fetch": "ts-node --transpile-only scripts/fetch-sources.ts",
    "kb:report": "ts-node --transpile-only scripts/kb-report.ts",
    "kb:export-itu": "ts-node --transpile-only scripts/export-itu.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@sonah/database": "workspace:^",
    "neo4j-driver": "5.27.0",
    "openai": "4.77.0",
    "pdf-parse": "1.1.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.19.43",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
